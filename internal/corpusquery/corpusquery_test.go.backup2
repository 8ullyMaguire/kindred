// The mode lists must not lie.
//
// `Modes()` originally returned all five declared modes, so
// `kindred corpus-query --mode similar` validated and then failed with
// "not implemented yet" from the dispatch switch. That is the same
// accepted-and-did-nothing shape this repo has found four times now: a value
// accepted, a flag advertised, and nothing behind it.
//
// So the invariant is stated as a test rather than left to a code review:
//   - every mode in Modes() has a Runner method, and
//   - every declared mode NOT in Modes() is documented as unimplemented.
//
// If someone adds a mode to the constant block and forgets both, this fails.
package corpusquery

// implemented is the dispatch surface, mirrored here deliberately.
//
// It is a hand-written table rather than reflection: the property worth checking
// is "a Runner method exists that does this mode's job", and only a human can
// say which method that is. Reflection over method names would pass for any
// method at all.
//
// The cost is that adding a mode requires editing this map, which is the point:
// it is a second place to forget, and the test below fails if you forget.
var implemented = map[Mode]func(*Runner) bool{
	ModeFandomRanking: func(r *Runner) bool { return r != nil },
	ModeUnderrated:    func(r *Runner) bool { return r != nil },
	ModeTagNeighbours: func(r *Runner) bool { return r != nil },
}

// methodNames is the real assertion: the method must exist on *Runner with the
// right name and signature. A renamed method breaks compilation of this table,
// which is better than breaking silently.
var _ = map[Mode]any{
	ModeFandomRanking: (*Runner).FandomRanking,
	ModeUnderrated:    (*Runner).Underrated,
	ModeTagNeighbours: (*Runner).TagNeighbours,
}

func TestModesAreImplemented(t *testing.T) {
	for _, m := range Modes() {
		if _, ok := implemented[m]; !ok {
			t.Errorf("Modes() advertises %q but nothing implements it; a mode "+
				"that validates and then refuses is worse than one that never "+
				"existed", m)
		}
	}
	// And the other direction: anything in the dispatch table must be
	// advertised, or `--help` understates what runs.
	for m := range implemented {
		if !IsImplemented(m) {
			t.Errorf("%q has an implementation but is not in Modes(), so "+
				"--help and the mode list understate what runs", m)
		}
	}
}

func TestUnimplementedModesAreDeclaredAsSuch(t *testing.T) {
	// A declared mode with no implementation must be DOCUMENTED as such, so a
	// reader of the source sees "not implemented" rather than discovering it
	// from a runtime error.
	//
	// This reads corpusquery.go at test time on purpose: the claim is about a
	// COMMENT, so the only way to check it is to look at the comment.
	src, err := os.ReadFile("corpusquery.go")
	if err != nil {
		t.Skipf("cannot read the source to check its comments: %v", err)
	}
	text := string(src)

	for _, m := range DeclaredModes() {
		if IsImplemented(m) {
			continue
		}
		// Find the constant declaration and look at the comment above it.
		idx := strings.Index(text, "Mode"+modeConstSuffix(m))
		if idx < 0 {
			continue // declared via a different spelling; skip rather than lie
		}
		// Walk back over the comment block immediately preceding it.
		start := strings.LastIndex(text[:idx], "\n\n")
		if start < 0 {
			start = 0
		}
		window := text[start:idx]
		if !strings.Contains(strings.ToLower(window), "not implemented") {
			t.Errorf("mode %q is declared, has no implementation, and the comment "+
				"above it does not say so; a reader would assume it works", m)
		}
	}
}

// modeConstSuffix maps a mode value to its Go constant name fragment.
func modeConstSuffix(m Mode) string {
	switch m {
	case ModeFandomRanking:
		return "FandomRanking Mode = \"fandom-ranking\""
	case ModeFandomLandscape:
		return "FandomLandscape Mode = \"fandom-landscape\""
	case ModeTagNeighbours:
		return "TagNeighbours Mode = \"tag-neighbours\""
	case ModeUnderrated:
		return "Underrated Mode = \"underrated\""
	case ModeSimilar:
		return "Similar Mode = \"similar\""
	}
	return string(m)
}

func contains(hay, needle string) bool { return strings.Contains(hay, needle) }

